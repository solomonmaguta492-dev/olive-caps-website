# Copy this file to .env and fill in your own values.
# Never commit .env to GitHub.

PORT=3000

# Password for the admin dashboard (admin.html)
ADMIN_PASSWORD=change-this-password

# mock = payments succeed automatically (for testing)
# sandbox = Safaricom Daraja sandbox
# production = live M-Pesa payments
MPESA_MODE=mock

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill: your Paybill number. Till (Buy Goods): the store number Safaricom gives you.
MPESA_SHORTCODE=174379
# Till (Buy Goods) only: your Till number. Leave empty for a Paybill.
MPESA_TILL_NUMBER=
MPESA_PASSKEY=
# Must be public HTTPS, e.g. https://your-app.onrender.com/api/mpesa/callback
MPESA_CALLBACK_URL=
